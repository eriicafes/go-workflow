{
  "name": "go-workflow",
  "version": "0.2.1",
  "description": "Event-sourced durable workflows for Go worlds.",
  "type": "module",
  "exports": {
    "./world-http": {
      "types": "./world-http/dist/index.d.mts",
      "default": "./world-http/dist/index.mjs"
    }
  },
  "files": [
    "world-http/dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "prepack": "npm run build && mv README.md .README.go.md && cp world-http/README.md README.md",
    "postpack": "mv .README.go.md README.md",
    "release": "changeset publish",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "Eric Afes <eriicafes@gmail.com>",
  "license": "MIT",
  "homepage": "https://go-workflow.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eriicafes/go-workflow.git"
  },
  "bugs": {
    "url": "https://github.com/eriicafes/go-workflow/issues"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@workflow/world": "^5.0.4",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "cbor-x": "^1.6.6"
  }
}
